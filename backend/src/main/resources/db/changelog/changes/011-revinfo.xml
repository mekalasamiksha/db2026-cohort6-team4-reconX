<?xml version="1.0" encoding="UTF-8"?>
<!--
 ============================================================================
 TICKET-ADV052 — Hibernate Envers revision table
 WHAT:    Creates the default revinfo table used by Envers when no custom
          revision entity is configured.
 WHY:     Legacy audited entities in com.dbtraining.reconx.domain require the
          revision table to exist during JPA validation.
 ============================================================================
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="011-create-revinfo" author="trainer">
        <createTable tableName="revinfo">
            <column name="rev" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="revtstmp" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="revinfo"/>
        </rollback>
    </changeSet>

</databaseChangeLog>