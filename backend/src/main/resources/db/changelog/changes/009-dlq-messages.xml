<?xml version="1.0" encoding="UTF-8"?>
<!--
 ============================================================================
 TICKET-ADV136 — DLQ message persistence
 WHAT:    Stores dead-letter Kafka payloads so admins can replay failed events.
 WHY:     Hibernate validates the DLQ repository entity at startup, so the
          table must exist in every profile that scans the entity.
 ============================================================================
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="009-create-dlq-messages" author="trainer">
        <createTable tableName="dlq_messages">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="event_id" type="UUID"><constraints nullable="false" unique="true"/></column>
            <column name="trade_ref" type="VARCHAR(30)"><constraints nullable="false"/></column>
            <column name="original_topic" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="partition" type="INT"><constraints nullable="false"/></column>
            <column name="offset" type="BIGINT"><constraints nullable="false"/></column>
            <column name="payload_json" type="CLOB"><constraints nullable="false"/></column>
            <column name="reason" type="CLOB"><constraints nullable="false"/></column>
            <column name="first_seen" type="TIMESTAMP"><constraints nullable="false"/></column>
        </createTable>
        <rollback>
            <dropTable tableName="dlq_messages"/>
        </rollback>
    </changeSet>

</databaseChangeLog>